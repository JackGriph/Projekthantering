@using Projekthantering.Client.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="sidenav">
    <div class="sidenav-brand">
        <span class="sidenav-logo"><i class="bi bi-kanban"></i></span>
        <div>
            <div class="sidenav-brand-title">Projekthantering</div>
        </div>
    </div>

    <nav class="sidenav-nav">
        <NavLink class="sidenav-link" href="" Match="NavLinkMatch.All">
            <i class="bi bi-house-door"></i>
            <span>Hem</span>
        </NavLink>

        <AuthorizeView>
            <Authorized>
                <NavLink class="sidenav-link" href="boards">
                    <i class="bi bi-kanban"></i>
                    <span>Tavlor</span>
                </NavLink>
                <NavLink class="sidenav-link" href="settings">
                    <i class="bi bi-gear"></i>
                    <span>Inställningar</span>
                </NavLink>
            </Authorized>
            <NotAuthorized>
                <NavLink class="sidenav-link" href="login">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Logga in</span>
                </NavLink>
                <NavLink class="sidenav-link" href="register">
                    <i class="bi bi-person-plus"></i>
                    <span>Registrera</span>
                </NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </nav>

    <AuthorizeView>
        <Authorized>
            <div class="sidenav-footer">
                <div class="sidenav-user">
                    <div class="sidenav-avatar">
                        <i class="bi bi-person-circle"></i>
                    </div>
                    <span class="sidenav-username">@context.User.Identity?.Name</span>
                </div>
                <button class="sidenav-logout" @onclick="HandleLogout">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logga ut</span>
                </button>
            </div>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}
