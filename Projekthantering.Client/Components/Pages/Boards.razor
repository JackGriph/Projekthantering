@page "/boards"
@rendermode InteractiveServer
@using Projekthantering.Shared.DTOs
@using Projekthantering.Client.Services
@inject IBoardService BoardService
@inject NavigationManager Navigation
@inject AuthStateProvider AuthState

<PageTitle>Mina tavlor</PageTitle>

<div class="boards-welcome">
    <h2 class="welcome-title">Välkommen tillbaka</h2>
    <p class="welcome-subtitle">Hantera dina pågående arkitektoniska projekt och utförandeplaner med precision.</p>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (showCreateForm)
{
    <CreateBoardDialog OnCreated="HandleBoardCreated" OnCancel="HandleBoardCancelled" />
}

@if (boards == null)
{
    <p class="text-muted"><em>Laddar...</em></p>
}
else
{
    <div class="board-grid">
        <div class="board-card board-card-create" @onclick="() => showCreateForm = true">
            <div class="create-icon">
                <i class="bi bi-plus-lg"></i>
            </div>
            <span class="create-label">Skapa ny tavla</span>
        </div>

        @foreach (var board in boards)
        {
            <BoardCard Board="board" OnDelete="HandleDeleteBoard" />
        }
    </div>
}

@code {
    private List<BoardDto>? boards;
    private bool showCreateForm;
    private string? errorMessage;
    private bool _loaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Säkerställ att token laddats från ProtectedLocalStorage (kräver JS interop)
            await AuthState.GetAuthenticationStateAsync();
            await LoadBoards();
            _loaded = true;
            StateHasChanged();
        }
    }

    private async Task LoadBoards()
    {
        try
        {
            boards = await BoardService.GetBoardsAsync();
        }
        catch
        {
            errorMessage = "Kunde inte ladda tavlor.";
        }
    }

    private async Task HandleDeleteBoard(int id)
    {
        errorMessage = null;
        var ok = await BoardService.DeleteBoardAsync(id);
        if (!ok)
        {
            errorMessage = "Kunde inte ta bort tavlan.";
            return;
        }
        await LoadBoards();
    }

    private async Task HandleBoardCreated()
    {
        showCreateForm = false;
        await LoadBoards();
    }

    private void HandleBoardCancelled()
    {
        showCreateForm = false;
    }
}
