@page "/boards"
@attribute [StreamRendering]
@using Projekthantering.Shared.DTOs
@using Projekthantering.Client.Services
@inject BoardService BoardService
@inject NavigationManager Navigation

<PageTitle>Mina tavlor</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Mina tavlor</h2>
    <button class="btn btn-primary" @onclick="() => showCreateForm = true">
        + Ny tavla
    </button>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (showCreateForm)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Skapa ny tavla</h5>
            <EditForm Model="createRequest" OnValidSubmit="HandleCreateBoard"
                      FormName="create-board">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label">Titel</label>
                    <InputText @bind-Value="createRequest.Title" class="form-control" />
                    <ValidationMessage For="() => createRequest.Title" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Beskrivning (valfritt)</label>
                    <InputTextArea @bind-Value="createRequest.Description"
                                   class="form-control" rows="2" />
                </div>
                <button type="submit" class="btn btn-success me-2">Skapa</button>
                <button type="button" class="btn btn-secondary"
                        @onclick="CancelCreate">Avbryt</button>
            </EditForm>
        </div>
    </div>
}

@if (boards == null)
{
    <p><em>Laddar...</em></p>
}
else if (boards.Count == 0)
{
    <p class="text-muted">Du har inga tavlor ännu. Skapa en ovan!</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var board in boards)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@board.Title</h5>
                        @if (!string.IsNullOrEmpty(board.Description))
                        {
                            <p class="card-text text-muted">@board.Description</p>
                        }
                        <p class="card-text">
                            <small class="text-muted">
                                Skapad av @board.OwnerName
                                · @board.CreatedAt.ToLocalTime().ToString("d MMM yyyy")
                            </small>
                        </p>
                    </div>
                    <div class="card-footer d-flex justify-content-between">
                        <a class="btn btn-outline-primary btn-sm"
                           href="/boards/@board.Id">Öppna</a>
                        <button class="btn btn-outline-danger btn-sm"
                                @onclick="() => HandleDeleteBoard(board.Id)">
                            Ta bort
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<BoardDto>? boards;
    private CreateBoardRequest createRequest = new();
    private bool showCreateForm;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadBoards();
    }

    private async Task LoadBoards()
    {
        try
        {
            boards = await BoardService.GetBoardsAsync();
        }
        catch
        {
            errorMessage = "Kunde inte ladda tavlor.";
        }
    }

    private async Task HandleCreateBoard()
    {
        errorMessage = null;
        var result = await BoardService.CreateBoardAsync(createRequest);
        if (result == null)
        {
            errorMessage = "Kunde inte skapa tavlan.";
            return;
        }
        createRequest = new();
        showCreateForm = false;
        await LoadBoards();
    }

    private async Task HandleDeleteBoard(int id)
    {
        errorMessage = null;
        var ok = await BoardService.DeleteBoardAsync(id);
        if (!ok)
        {
            errorMessage = "Kunde inte ta bort tavlan.";
            return;
        }
        await LoadBoards();
    }

    private void CancelCreate()
    {
        createRequest = new();
        showCreateForm = false;
    }
}
