@page "/boards/{BoardId:int}"
@page "/boards/{BoardId:int}"
@attribute [StreamRendering]
@using Projekthantering.Client.Services
@using Projekthantering.Client.Components.Shared
@inject BoardService BoardService
@inject ListService ListService
@inject NavigationManager Navigation

<PageTitle>@(board?.Title ?? "Tavla")</PageTitle>

@* ?? Error banner ?? *@
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible">
        @errorMessage
        <button type="button" class="btn-close"
                @onclick="() => errorMessage = null"></button>
    </div>
}

@* ?? Loading spinner ?? *@
@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height:40vh">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Laddar...</span>
        </div>
    </div>
}
else if (board != null)
{
    @* ?? Board header ?? *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <a href="/boards" class="text-muted text-decoration-none me-2">? Tavlor</a>
            <h2 class="d-inline mb-0">@board.Title</h2>
        </div>
        <button class="btn btn-primary btn-sm"
                @onclick="() => showAddList = true">+ Ny lista</button>
    </div>

    @if (!string.IsNullOrEmpty(board.Description))
    {
        <p class="text-muted mb-3">@board.Description</p>
    }

    @* ?? Add-list form ?? *@
    @if (showAddList)
    {
        <div class="card mb-3" style="max-width:272px">
            <div class="card-body py-2">
                <EditForm Model="newListRequest" OnValidSubmit="HandleCreateList"
                          FormName="add-list">
                    <DataAnnotationsValidator />
                    <InputText @bind-Value="newListRequest.Title"
                               class="form-control form-control-sm mb-2"
                               placeholder="Listtitel..." />
                    <ValidationMessage For="() => newListRequest.Title" />
                    <button type="submit" class="btn btn-success btn-sm me-1">Lägg till</button>
                    <button type="button" class="btn btn-secondary btn-sm"
                            @onclick="CancelAddList">Avbryt</button>
                </EditForm>
            </div>
        </div>
    }

    @* ?? Kanban board — one ListComponent per list ?? *@
    <div class="kanban-board">
        @foreach (var list in lists)
        {
            <ListComponent List="list"
                           OnDeleted="HandleListDeleted"
                           OnUpdated="HandleListUpdated" />
        }
    </div>
}

@code {
    [Parameter] public int BoardId { get; set; }

    private BoardDto? board;
    private List<BoardListDto> lists = [];
    private bool isLoading = true;
    private string? errorMessage;

    private bool showAddList;
    private CreateListRequest newListRequest = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadBoardAsync();
    }

    private async Task LoadBoardAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            board = await BoardService.GetBoardAsync(BoardId);
            if (board == null)
            {
                Navigation.NavigateTo("/boards");
                return;
            }
            lists = await ListService.GetListsAsync(BoardId);
        }
        catch
        {
            errorMessage = "Kunde inte ladda tavlan. Kontrollera anslutningen och försök igen.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleCreateList()
    {
        errorMessage = null;
        var result = await ListService.CreateListAsync(BoardId, newListRequest);
        if (result == null) { errorMessage = "Kunde inte skapa listan."; return; }
        lists.Add(result);
        newListRequest = new();
        showAddList = false;
    }

    private void HandleListDeleted(int listId)
        => lists.RemoveAll(l => l.Id == listId);

    private void HandleListUpdated(BoardListDto updated)
    {
        var idx = lists.FindIndex(l => l.Id == updated.Id);
        if (idx >= 0) lists[idx] = updated;
    }

    private void CancelAddList() { showAddList = false; newListRequest = new(); }
}

