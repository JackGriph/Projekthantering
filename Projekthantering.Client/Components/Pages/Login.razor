@page "/login"
@rendermode InteractiveServer
@layout Projekthantering.Client.Components.Layout.AuthLayout
@using Projekthantering.Shared.DTOs
@using Projekthantering.Client.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="auth-hero">
    <div class="auth-hero-content">
        <div class="auth-logo">
            <i class="bi bi-globe2"></i>
            <span>PLANIT</span>
        </div>
        <h1 class="auth-hero-title">
            Hantera dina projekt med <span class="auth-hero-highlight">PlanIt</span>
        </h1>
        <p class="auth-hero-desc">
            Ett kraftfullt projektverktyg för team.<br />
            Organisera, planera och samarbeta i en miljö byggd för klarhet.
        </p>
        <span class="auth-badge">Skolprojekt 2026</span>
    </div>
</div>

<div class="auth-form-panel">
    <div class="auth-form-container">
        <h2 class="auth-form-title">Välkomna tillbaka</h2>
        <p class="auth-form-subtitle">Ange dina uppgifter för att få tillgång till dina tavlor.</p>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="auth-error">@errorMessage</div>
        }

        <EditForm Model="loginRequest" OnValidSubmit="HandleLogin" FormName="login-form">
            <DataAnnotationsValidator />

            <div class="auth-field">
                <label class="auth-label">E-POSTADRESS</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-envelope"></i>
                    <InputText @bind-Value="loginRequest.Email" class="auth-input" placeholder="namn@foretag.se" />
                </div>
                <ValidationMessage For="() => loginRequest.Email" />
            </div>

            <div class="auth-field">
                <label class="auth-label">LÖSENORD</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-lock"></i>
                    <InputText @bind-Value="loginRequest.Password" class="auth-input" type="@(showPassword ? "text" : "password")" placeholder="Ditt lösenord" />
                    <button type="button" class="auth-toggle-pw" @onclick="() => showPassword = !showPassword">
                        <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                    </button>
                </div>
                <ValidationMessage For="() => loginRequest.Password" />
            </div>

            <button type="submit" class="auth-submit-btn">
                Logga in <i class="bi bi-arrow-right"></i>
            </button>
        </EditForm>

        <p class="auth-switch">
            Har du inget konto? <a href="/register">Skapa ett konto</a>
        </p>
    </div>
</div>

@code {
    private LoginRequest loginRequest = new();
    private string? errorMessage;
    private bool showPassword;

    private async Task HandleLogin()
    {
        errorMessage = null;
        var result = await AuthService.LoginAsync(loginRequest);
        if (!result.Success)
        {
            errorMessage = result.ErrorMessage ?? "Felaktiga inloggningsuppgifter.";
            return;
        }
        Navigation.NavigateTo("/boards");
    }
}
