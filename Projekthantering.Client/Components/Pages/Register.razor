@page "/register"
@rendermode InteractiveServer
@using Projekthantering.Shared.DTOs
@using Projekthantering.Client.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation

<h3>Registrera</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<EditForm Model="registerRequest" OnValidSubmit="HandleRegister">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="mb-3">
        <label class="form-label">Användarnamn</label>
        <InputText @bind-Value="registerRequest.Username"
                   class="form-control" />
        <ValidationMessage For="() => registerRequest.Username" />
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText @bind-Value="registerRequest.Email"
                   class="form-control" />
        <ValidationMessage For="() => registerRequest.Email" />
    </div>
    <div class="mb-3">
        <label class="form-label">Lösenord</label>
        <InputText @bind-Value="registerRequest.Password"
                   class="form-control" type="password" />
        <ValidationMessage For="() => registerRequest.Password" />
    </div>
    <div class="mb-3">
        <label class="form-label">Bekräfta lösenord</label>
        <InputText @bind-Value="registerRequest.ConfirmPassword"
                   class="form-control" type="password" />
        <ValidationMessage For="() => registerRequest.ConfirmPassword" />
    </div>
    <button type="submit" class="btn btn-primary">Registrera</button>
    <a href="/login" class="btn btn-link">Har redan konto?</a>
</EditForm>

@code {
    private RegisterRequest registerRequest = new();
    private string? errorMessage;

    private async Task HandleRegister()
    {
        errorMessage = null;
        var result = await AuthService.RegisterAsync(registerRequest);
        if (!result.Success)
        {
            errorMessage = result.ErrorMessage ?? "Registrering misslyckades.";
            return;
        }
        Navigation.NavigateTo("/boards");
    }
}
