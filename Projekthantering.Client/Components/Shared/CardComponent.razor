@inject HttpClient Http

@inject HttpClient Http

<div class="kanban-card">
    @if (isEditing)
    {
        <EditForm Model="editRequest" OnValidSubmit="HandleUpdate"
                  FormName="@($"edit-card-{Card.Id}")">
            <DataAnnotationsValidator />

            <div class="mb-1">
                <label class="form-label form-label-sm mb-0">Titel</label>
                <InputText @bind-Value="editRequest.Title"
                           class="form-control form-control-sm" />
                <ValidationMessage For="() => editRequest.Title" />
            </div>

            <div class="mb-1">
                <label class="form-label form-label-sm mb-0">Beskrivning</label>
                <InputTextArea @bind-Value="editRequest.Description"
                               class="form-control form-control-sm"
                               rows="2" />
                <ValidationMessage For="() => editRequest.Description" />
            </div>

            <div class="mb-1">
                <label class="form-label form-label-sm mb-0">Status</label>
                <InputSelect @bind-Value="editRequest.Status"
                             class="form-select form-select-sm">
                    <option value="todo">Att göra</option>
                    <option value="in_progress">Pågående</option>
                    <option value="done">Klar</option>
                </InputSelect>
            </div>

            <div class="mb-2">
                <label class="form-label form-label-sm mb-0">Tilldelad</label>
                <InputText @bind-Value="editRequest.AssignedTo"
                           class="form-control form-control-sm"
                           placeholder="Användarnamn..." />
                <ValidationMessage For="() => editRequest.AssignedTo" />
            </div>

            <button type="submit" class="btn btn-success btn-sm me-1">Spara</button>
            <button type="button" class="btn btn-secondary btn-sm"
                    @onclick="CancelEdit">Avbryt</button>
        </EditForm>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-start">
            <span class="fw-semibold small">@Card.Title</span>
            <div class="text-nowrap ms-1">
                <button class="btn btn-link btn-sm p-0 me-1 text-secondary"
                        @onclick="StartEdit" title="Redigera">??</button>
                <button class="btn btn-link btn-sm p-0 text-danger"
                        @onclick="HandleDelete" title="Ta bort">??</button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Card.Description))
        {
            <p class="text-muted small mb-1 mt-1">@Card.Description</p>
        }
        <div class="kanban-card-meta">
            <span class="badge @StatusBadgeClass(Card.Status)">
                @StatusLabel(Card.Status)
            </span>
            @if (!string.IsNullOrEmpty(Card.AssigneeName))
            {
                <span title="Tilldelad">?? @Card.AssigneeName</span>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger py-1 px-2 mt-1 small">@errorMessage</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public CardDto Card { get; set; } = default!;
    [Parameter] public EventCallback<CardDto> OnCardUpdated { get; set; }
    [Parameter] public EventCallback<int> OnCardDeleted { get; set; }

    private bool isEditing;
    private UpdateCardRequest editRequest = new();
    private string? errorMessage;

    private void StartEdit()
    {
        editRequest = new UpdateCardRequest
        {
            Title      = Card.Title,
            Description = Card.Description,
            Status     = Card.Status,
            AssignedTo = Card.AssigneeName,
            DueDate    = Card.DueDate
        };
        isEditing = true;
    }

    private void CancelEdit()
    {
        isEditing = false;
        errorMessage = null;
    }

    private async Task HandleUpdate()
    {
        errorMessage = null;
        var response = await Http.PatchAsJsonAsync($"api/cards/{Card.Id}", editRequest);
        if (!response.IsSuccessStatusCode)
        {
            errorMessage = "Kunde inte uppdatera kortet.";
            return;
        }
        var updated = await response.Content.ReadFromJsonAsync<CardDto>();
        if (updated is null) { errorMessage = "Ogiltigt svar från servern."; return; }
        isEditing = false;
        await OnCardUpdated.InvokeAsync(updated);
    }

    private async Task HandleDelete()
    {
        errorMessage = null;
        var response = await Http.DeleteAsync($"api/cards/{Card.Id}");
        if (!response.IsSuccessStatusCode)
        {
            errorMessage = "Kunde inte ta bort kortet.";
            return;
        }
        await OnCardDeleted.InvokeAsync(Card.Id);
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "in_progress" => "badge-status-in_progress",
        "done"        => "badge-status-done",
        _             => "badge-status-todo"
    };

    private static string StatusLabel(string status) => status switch
    {
        "in_progress" => "Pågående",
        "done"        => "Klar",
        _             => "Att göra"
    };
}
