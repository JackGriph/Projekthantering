@using Projekthantering.Shared.DTOs
@inject NavigationManager Navigation

<div class="board-card" @onclick="Navigate">
    <div class="board-card-header">
        <span class="board-card-title">@Board.Title</span>
        <button class="board-card-delete" @onclick:stopPropagation
                @onclick="() => OnDelete.InvokeAsync(Board.Id)">
            <i class="bi bi-three-dots"></i>
        </button>
    </div>
    <div class="board-card-meta">
        SENAST ÄNDRAD: @Board.CreatedAt.ToLocalTime().ToString("d MMM yyyy").ToUpper()
    </div>
    @if (!string.IsNullOrEmpty(Board.Description))
    {
        <div class="board-card-desc">@Board.Description</div>
    }
</div>

@code {
    [Parameter] public BoardDto Board { get; set; } = default!;
    [Parameter] public EventCallback<int> OnDelete { get; set; }

    private void Navigate() => Navigation.NavigateTo($"/boards/{Board.Id}");
}
